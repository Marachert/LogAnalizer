<Window x:Class="LogAnalizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Analyzer"
        Height="900"
        Width="1400"
        AllowDrop="True"
        Drop="Window_OnDrop"
        DragOver="Window_OnDragOver">
    <Grid Margin="12">
        <Border BorderBrush="#CCCCCC"
                BorderThickness="1"
                Padding="12"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Drag and drop a folder with logs (.log) onto the window or use the upload button."
                           FontWeight="SemiBold" />

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,8,0,8">
                    <TextBlock Text="Folder:"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />

                    <TextBox Width="420"
                             Text="{Binding LogsFolder}"
                             IsReadOnly="True" />

                    <Button Content="Browse"
                            Margin="8,0,0,0"
                            Padding="12,4"
                            Click="SelectFolder_OnClick" />

                    <TextBlock Text="Duration from"
                               Margin="24,0,6,0"
                               VerticalAlignment="Center" />

                    <TextBox Width="120"
                             Text="{Binding DurationFromText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Format 00:00:00" />

                    <TextBlock Text="to"
                               Margin="8,0,6,0"
                               VerticalAlignment="Center" />

                    <TextBox Width="120"
                             Text="{Binding DurationToText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Format 00:00:00" />

                    <TextBlock Text="Sort by"
                               Margin="16,0,6,0"
                               VerticalAlignment="Center" />

                    <ComboBox Width="200"
                              ItemsSource="{Binding DurationSortOptions}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedDurationSortOption}" />

                    <Button Content="Search"
                            Margin="8,0,0,0"
                            Padding="12,4"
                            Click="Search_OnClick" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#666" />
                </StackPanel>

                <TabControl Grid.Row="2"
                            ItemsSource="{Binding DurationTabs}"
                            SelectedItem="{Binding SelectedDurationTab}"
                            TabStripPlacement="Left">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid KeyboardNavigation.TabNavigation="Local">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ScrollViewer Grid.Column="0"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="True">
                                    <!-- IMPORTANT: WPF TabPanel does NOT have Orientation property -->
                                    <TabPanel IsItemsHost="True"
                                              Margin="0,0,8,0" />
                                </ScrollViewer>

                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="SelectedContent" />
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>

                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Header}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>

                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border BorderBrush="#DDD"
                                        BorderThickness="1"
                                        Padding="8"
                                        Background="#F9F9F9"
                                        CornerRadius="4"
                                        MinHeight="60">
                                    <TextBlock Text="{Binding AddedLogLine}"
                                               TextWrapping="Wrap" />
                                </Border>

                                <GridSplitter Grid.Row="1"
                                              Height="6"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Background="#DDD"
                                              ResizeBehavior="PreviousAndNext"
                                              ShowsPreview="True" />

                                <DataGrid Grid.Row="2"
                                          ItemsSource="{Binding Interactions}"
                                          AutoGenerateColumns="False"
                                          CanUserSortColumns="True"
                                          CanUserResizeColumns="True"
                                          IsReadOnly="True"
                                          Margin="0,8,0,8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#"
                                                            Binding="{Binding Index}"
                                                            Width="40" />
                                        <DataGridTextColumn Header="InteractionId"
                                                            Binding="{Binding InteractionId}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="InteractionType"
                                                            Binding="{Binding InteractionType}"
                                                            Width="120" />
                                        <DataGridTextColumn Header="RecordingProfileId"
                                                            Binding="{Binding RecordingProfileId}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="Date"
                                                            Binding="{Binding Date}"
                                                            Width="160" />
                                        <DataGridTextColumn Header="MetaDataFileName"
                                                            Binding="{Binding MetaDataFileName}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="Contents"
                                                            Binding="{Binding Contents}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="TranscriptFileName"
                                                            Binding="{Binding TranscriptFileName}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="RetentionDate"
                                                            Binding="{Binding RetentionDate}"
                                                            Width="160" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <GridSplitter Grid.Row="3"
                                              Height="6"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Background="#DDD"
                                              ResizeBehavior="PreviousAndNext"
                                              ShowsPreview="True" />

                                <Border Grid.Row="4"
                                        BorderBrush="#DDD"
                                        BorderThickness="1"
                                        Padding="8"
                                        Background="#F9F9F9"
                                        CornerRadius="4"
                                        MinHeight="60">
                                    <TextBlock Text="{Binding DurationLogLine}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Window>
