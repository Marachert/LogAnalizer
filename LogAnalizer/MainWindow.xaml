<Window x:Class="LogAnalizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Analizer" Height="900" Width="1400"
        AllowDrop="True"
        Drop="Window_OnDrop"
        DragOver="Window_OnDragOver">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="12" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Перетащите папку с логами (.log) в окно или используйте кнопку загрузки." FontWeight="SemiBold" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                    <TextBlock Text="Папка:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="420" Text="{Binding LogsFolder}" IsReadOnly="True" />
                    <Button Content="Выбрать" Margin="8,0,0,0" Padding="12,4" Click="SelectFolder_OnClick" />
                    <TextBlock Text="Duration &gt;" Margin="24,0,6,0" VerticalAlignment="Center" />
                    <TextBox Width="120" Text="{Binding DurationFilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Формат 00:00:00" />
                    <Button Content="Найти" Margin="8,0,0,0" Padding="12,4" Click="Search_OnClick" />
                    <TextBlock Text="{Binding StatusMessage}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#666" />
                </StackPanel>

                <TabControl Grid.Row="2" ItemsSource="{Binding DurationTabs}" SelectedItem="{Binding SelectedDurationTab}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Header}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border BorderBrush="#DDD" BorderThickness="1" Padding="8" Background="#F9F9F9" CornerRadius="4">
                                    <TextBlock Text="{Binding AddedLogLine}" TextWrapping="Wrap" />
                                </Border>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding Interactions}" AutoGenerateColumns="False"
                                          CanUserSortColumns="True" IsReadOnly="True" Margin="0,8,0,8">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" />
                                        <DataGridTextColumn Header="InteractionId" Binding="{Binding InteractionId}" Width="*" />
                                        <DataGridTextColumn Header="InteractionType" Binding="{Binding InteractionType}" Width="120" />
                                        <DataGridTextColumn Header="RecordingProfileId" Binding="{Binding RecordingProfileId}" Width="*" />
                                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="160" />
                                        <DataGridTextColumn Header="MetaDataFileName" Binding="{Binding MetaDataFileName}" Width="*" />
                                        <DataGridTextColumn Header="Contents" Binding="{Binding Contents}" Width="*" />
                                        <DataGridTextColumn Header="TranscriptFileName" Binding="{Binding TranscriptFileName}" Width="*" />
                                        <DataGridTextColumn Header="RetentionDate" Binding="{Binding RetentionDate}" Width="160" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" Padding="8" Background="#F9F9F9" CornerRadius="4">
                                    <TextBlock Text="{Binding DurationLogLine}" TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="PDF анализ сетевых событий" FontWeight="SemiBold" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                    <TextBlock Text="PDF файл:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="420" Text="{Binding PdfFilePath}" IsReadOnly="True" />
                    <Button Content="Загрузить PDF" Margin="8,0,0,0" Padding="12,4" Click="LoadPdf_OnClick" />
                    <TextBlock Text="{Binding PdfStatusMessage}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#666" />
                </StackPanel>

                <DataGrid Grid.Row="2" ItemsSource="{Binding PdfAnalysisResults}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" />
                        <DataGridTextColumn Header="InteractionId" Binding="{Binding InteractionId}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="160" />
                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
